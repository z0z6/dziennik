{
  "name": "dziennik-wtz",
  "productName": "Dziennik WTZ",
  "version": "1.0.0",
  "description": "Dziennik psychologa WTZ – automatyczne dokumentowanie pracy z pomocą Claude",
  "main": "src/main/main.js",
  "author": "z0z6",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/run-tests.js",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.0.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "pl.z0z6.dziennikwtz",
    "productName": "Dziennik WTZ",
    "artifactName": "Dziennik-WTZ-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "afterPack": "build/afterPack.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "dziennik-wtz",
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Dziennik psychologa WTZ",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Dziennik-WTZ-${version}-portable.exe"
    }
  },
  "desktopName": "dziennik-wtz.desktop"
}
